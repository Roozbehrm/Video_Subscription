# Copy this file to .env and fill in real values for your machine/deployment.
# Used automatically by Docker (docker-compose.yml has `env_file: .env`).
# Running locally without Docker: settings.py uses python-decouple, which reads
# this .env file automatically (it looks for it next to manage.py) - no export
# or extra setup needed. Just create .env from this template and fill it in.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Docker / docker-compose only ---
# Password for the Postgres container (docker-compose.yml wires DATABASE_URL for you).
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # set this yourself outside Docker

# --- Channels (live updates) ---
# Leave unset to use the in-memory layer (fine for local dev / a single process).
# Set to use Redis in production (required once you run more than one process).
REDIS_URL=redis://localhost:6379/2

# --- Celery (subscription renew/expire job) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 1 = run tasks inline, no worker/broker needed (handy for local dev without Redis)
CELERY_TASK_ALWAYS_EAGER=0

# --- Payment gateway ---
# Dotted path to the gateway used by POST /api/subscriptions/ (instant-charge flow).
PAYMENT_GATEWAY=subscriptions.gateway.MockGateway

# --- Zarinpal (redirect-based checkout: /api/subscriptions/checkout/zarinpal/) ---
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=1
# Must be a publicly reachable URL so Zarinpal can redirect back to it (use ngrok for local testing).
SITE_BASE_URL=http://127.0.0.1:8000
